# Copy to .env.local for local development; set the same variables in the Vercel project settings.

# Production origin, without trailing slash (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=

# Contact form (src/app/api/contact/route.ts), sent through Resend (https://resend.com).
# Without RESEND_API_KEY or CONTACT_TO_EMAIL the site still builds and runs: the form shows a clean
# error message and the server logs why nothing was sent.
RESEND_API_KEY=
# Mailbox that receives the messages. Never sent to the browser. Several addresses: comma-separated.
CONTACT_TO_EMAIL=
# Optional. Sender, on a domain verified in Resend, e.g. "Corvus Web Studio <contact@your-domain>".
# Defaults to Resend's test sender, which only delivers to the Resend account owner's address.
CONTACT_FROM_EMAIL=

# Notion -> Markdown news sync (`npm run news:sync`, see docs/NOTION.md). Local use only: not needed on Vercel.
# Secret of the internal Notion integration (starts with ntn_ or secret_).
NOTION_TOKEN=
# Id of the news database (the 32 characters before "?v=" in its URL).
NOTION_NEWS_DATABASE_ID=
